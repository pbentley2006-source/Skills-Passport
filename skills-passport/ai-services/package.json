{
  "name": "skills-passport-ai-services",
  "version": "1.0.0",
  "description": "AI/NLP processing modules for Skills Passport",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "openai": "^4.11.1",
    "pdf-parse": "^1.1.1",
    "mammoth": "^1.6.0",
    "@faker-js/faker": "^8.1.0",
    "natural": "^6.5.0",
    "compromise": "^14.10.0"
  },
  "devDependencies": {
    "@types/node": "^20.6.0",
    "@types/jest": "^29.5.5",
    "typescript": "^5.2.2",
    "ts-node": "^10.9.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["<rootDir>/src", "<rootDir>/tests"],
    "testMatch": ["**/__tests__/**/*.ts", "**/?(*.)+(spec|test).ts"],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts",
      "!src/index.ts"
    ]
  }
}
